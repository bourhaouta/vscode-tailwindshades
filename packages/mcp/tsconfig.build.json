// Writes the .d.ts files to dist/. The JS comes from scripts/build.mjs.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  // The stdio entry is not part of the library API
  "exclude": ["src/bin.ts"]
}
