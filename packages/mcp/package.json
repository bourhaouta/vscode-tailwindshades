{
  "name": "tailwindshades-mcp",
  "version": "1.5.0",
  "description": "MCP server that gives AI agents correct Tailwind CSS palettes (50–950) from any color, for Tailwind v4, v3, v2 and v1",
  "mcpName": "io.github.bourhaouta/tailwindshades",
  "author": "Omar Bourhaouta <bourhaouta@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/bourhaouta/vscode-tailwindshades/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/bourhaouta/vscode-tailwindshades/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bourhaouta/vscode-tailwindshades.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "tailwind",
    "tailwindcss",
    "color",
    "palette",
    "oklch",
    "ai"
  ],
  "type": "module",
  "bin": {
    "tailwindshades-mcp": "dist/bin.js"
  },
  "exports": {
    ".": {
      "tailwindshades-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "zod": "^4.6.5",
    "tailwindshades-cli": "^1.5.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
