{
  "name": "tailwindshades",
  "displayName": "Tailwind Shades",
  "description": "Generate Tailwind CSS color palettes (50–950) from any color, for Tailwind v4, v3, v2 and v1",
  "version": "1.0.0",
  "author": "Omar Bourhaouta <bourhaouta@gmail.com>",
  "homepage": "https://github.com/bourhaouta/vscode-tailwindshades",
  "bugs": {
    "url": "https://github.com/bourhaouta/vscode-tailwindshades/issues",
    "email": "bourhaouta@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bourhaouta/vscode-tailwindshades.git"
  },
  "publisher": "bourhaouta",
  "keywords": [
    "tailwind",
    "tailwindcss",
    "tailwind v4",
    "css",
    "color",
    "palette",
    "shades",
    "oklch",
    "theme"
  ],
  "galleryBanner": {
    "color": "#f1f5f8"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "category": "Tailwind Shades",
        "command": "tailwindshades.generateColorPalette",
        "title": "Generate color palette"
      },
      {
        "category": "Tailwind Shades",
        "command": "tailwindshades.generateColorPaletteAs",
        "title": "Generate color palette (choose version and output)…"
      },
      {
        "category": "Tailwind Shades",
        "command": "tailwindshades.generateColorPaletteCSSVars",
        "title": "Generate color palette as CSS variables"
      }
    ],
    "keybindings": [
      {
        "command": "tailwindshades.generateColorPalette",
        "key": "ctrl+k ctrl+g",
        "mac": "cmd+k cmd+g",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Tailwind Shades",
      "properties": {
        "tailwindshades.tailwindVersion": {
          "type": "string",
          "enum": ["auto", "4", "3", "2", "1"],
          "enumDescriptions": [
            "Read the tailwindcss version from the closest package.json (falls back to v4)",
            "Shades 50–950, @theme block in CSS, OKLCH colors",
            "Shades 50–950, tailwind.config.js object, hex colors",
            "Shades 50–900, tailwind.config.js object, hex colors",
            "Shades 100–900, tailwind.config.js object, hex colors"
          ],
          "default": "auto",
          "description": "Tailwind CSS version the palette is made for."
        },
        "tailwindshades.colorFormat": {
          "type": "string",
          "enum": ["auto", "oklch", "hex", "rgb"],
          "enumDescriptions": [
            "OKLCH for Tailwind v4, hex for older versions",
            "oklch(62.3% 0.214 259.815)",
            "#3b82f6",
            "rgb(59, 130, 246)"
          ],
          "default": "auto",
          "description": "Color format of the generated shades."
        },
        "tailwindshades.output": {
          "type": "string",
          "enum": ["auto", "theme", "config", "cssVariables"],
          "enumDescriptions": [
            "Pick from the file type: CSS files get @theme (v4) or CSS variables, JS/TS files get a config object",
            "Tailwind v4 @theme block: --color-brand-500: …;",
            "tailwind.config.js object: brand: { 500: '…' }",
            "Plain CSS variables: --brand-500: …;"
          ],
          "default": "auto",
          "description": "What the extension writes in place of the selected color."
        },
        "tailwindshades.promptForName": {
          "type": "boolean",
          "default": true,
          "description": "Ask for the color name (the closest Tailwind color name is suggested)."
        }
      }
    }
  },
  "scripts": {
    "palette": "node scripts/extract-palette.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "package": "vsce package --no-dependencies --skip-license",
    "vscode:prepublish": "npm run build -- --production"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^22.20.4",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "culori": "^4.0.2",
    "esbuild": "^0.28.2",
    "ovsx": "^1.2.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-v1": "npm:tailwindcss@^1.9.6",
    "tailwindcss-v3": "npm:tailwindcss@^3.4.19",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
